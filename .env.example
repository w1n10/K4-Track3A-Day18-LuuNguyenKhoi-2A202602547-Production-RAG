# cp .env.example .env
# Required for M4 (RAGAS eval) and M5 (Enrichment LLM calls) — điền 1 trong 2:
OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=...            # có key này → tự dùng Gemini (OpenAI-compatible endpoint)

# Tuỳ chọn:
# LLM_PROVIDER=gemini           # ép provider: gemini | openai
# LLM_MODEL=gemini-3.1-flash-lite
# EVAL_EMBEDDING_MODEL=gemini-embedding-001
# LLM_MAX_WORKERS=2             # số request song song khi enrichment (free tier Gemini nên để thấp)
